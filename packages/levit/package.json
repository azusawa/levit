{
  "name": "@yonailab/levit",
  "version": "0.4.0",
  "description": "A modern, zero-dependency, AI-ready hybrid web editor designed for seamless embedding and extensibility.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./levit.css": "./dist/levit.css",
    "./style.css": "./dist/levit.css"
  },
  "sideEffects": [
    "**/*.css",
    "./dist/index.js"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "llms.txt"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly && node scripts/strip-css-imports.mjs dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:package": "node scripts/check-package.mjs",
    "prepack": "node scripts/copy-docs.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run check:package"
  },
  "keywords": [
    "editor",
    "wysiwyg",
    "rich-text",
    "block-editor",
    "web-component",
    "zero-dependency",
    "ai-ready",
    "levit"
  ],
  "author": "yonailab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azusawa/levit.git"
  },
  "homepage": "https://github.com/azusawa/levit#readme",
  "bugs": {
    "url": "https://github.com/azusawa/levit/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
