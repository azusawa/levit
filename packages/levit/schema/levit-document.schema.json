{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/azusawa/levit/blob/main/packages/levit/schema/levit-document.schema.json",
  "title": "Levit document",
  "description": "A rich-text document: a flat list of blocks. Each block has a type, attrs and content, a list of text runs with marks (formatting). Line breaks inside a block are \"\\n\". List items are separate blocks; attrs.indent nests them. Table cells are blocks too: a table is a run of table_cell blocks, row after row.",
  "type": "object",
  "required": [
    "blocks"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/block"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "block": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "content"
          ],
          "properties": {
            "id": {
              "type": "string",
              "description": "Optional. A new id is made when missing."
            },
            "type": {
              "const": "paragraph"
            },
            "attrs": {
              "type": "object",
              "properties": {},
              "additionalProperties": false
            },
            "content": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/inline"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "content"
          ],
          "properties": {
            "id": {
              "type": "string",
              "description": "Optional. A new id is made when missing."
            },
            "type": {
              "const": "heading"
            },
            "attrs": {
              "type": "object",
              "properties": {
                "level": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 6
                }
              },
              "required": [
                "level"
              ],
              "additionalProperties": false
            },
            "content": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/inline"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "content"
          ],
          "properties": {
            "id": {
              "type": "string",
              "description": "Optional. A new id is made when missing."
            },
            "type": {
              "const": "blockquote"
            },
            "attrs": {
              "type": "object",
              "properties": {},
              "additionalProperties": false
            },
            "content": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/inline"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "content"
          ],
          "properties": {
            "id": {
              "type": "string",
              "description": "Optional. A new id is made when missing."
            },
            "type": {
              "const": "code_block"
            },
            "attrs": {
              "type": "object",
              "properties": {
                "language": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_+#.-]{1,32}$"
                }
              },
              "additionalProperties": false
            },
            "content": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/inline"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "content"
          ],
          "properties": {
            "id": {
              "type": "string",
              "description": "Optional. A new id is made when missing."
            },
            "type": {
              "const": "bullet_list_item"
            },
            "attrs": {
              "type": "object",
              "properties": {
                "indent": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 8,
                  "description": "Nesting level of a list item."
                }
              },
              "additionalProperties": false
            },
            "content": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/inline"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "content"
          ],
          "properties": {
            "id": {
              "type": "string",
              "description": "Optional. A new id is made when missing."
            },
            "type": {
              "const": "ordered_list_item"
            },
            "attrs": {
              "type": "object",
              "properties": {
                "indent": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 8,
                  "description": "Nesting level of a list item."
                }
              },
              "additionalProperties": false
            },
            "content": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/inline"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "content"
          ],
          "properties": {
            "id": {
              "type": "string",
              "description": "Optional. A new id is made when missing."
            },
            "type": {
              "const": "task_list_item"
            },
            "attrs": {
              "type": "object",
              "properties": {
                "checked": {
                  "type": "boolean"
                },
                "indent": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 8,
                  "description": "Nesting level of a list item."
                }
              },
              "required": [
                "checked"
              ],
              "additionalProperties": false
            },
            "content": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/inline"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "content"
          ],
          "properties": {
            "id": {
              "type": "string",
              "description": "Optional. A new id is made when missing."
            },
            "type": {
              "const": "horizontal_rule"
            },
            "attrs": {
              "type": "object",
              "properties": {},
              "additionalProperties": false
            },
            "content": {
              "$ref": "#/$defs/emptyContent"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "content"
          ],
          "properties": {
            "id": {
              "type": "string",
              "description": "Optional. A new id is made when missing."
            },
            "type": {
              "const": "image"
            },
            "attrs": {
              "type": "object",
              "properties": {
                "src": {
                  "type": "string",
                  "description": "http(s), blob, relative, or a bitmap data URL (no SVG)."
                },
                "alt": {
                  "type": "string"
                }
              },
              "required": [
                "src"
              ],
              "additionalProperties": false
            },
            "content": {
              "$ref": "#/$defs/emptyContent"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "A table cell. A table is a run of cells with the same table id, row after row.",
          "required": [
            "type",
            "content"
          ],
          "properties": {
            "id": {
              "type": "string",
              "description": "Optional. A new id is made when missing."
            },
            "type": {
              "const": "table_cell"
            },
            "attrs": {
              "type": "object",
              "properties": {
                "table": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The table this cell belongs to. Cells of one table follow each other."
                },
                "row": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The row this cell belongs to. Cells of one row follow each other, left to right."
                },
                "header": {
                  "type": "boolean",
                  "description": "A header cell."
                }
              },
              "required": [
                "table",
                "row"
              ],
              "additionalProperties": false
            },
            "content": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/inline"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "inline": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "marks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mark"
          }
        }
      },
      "additionalProperties": false
    },
    "emptyContent": {
      "description": "Blocks without text (dividers, images) have one empty text run.",
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "const": ""
          },
          "marks": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    },
    "mark": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "bold"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "italic"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "underline"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "strike"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "highlight"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "code"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "attrs"
          ],
          "properties": {
            "type": {
              "const": "link"
            },
            "attrs": {
              "type": "object",
              "properties": {
                "href": {
                  "type": "string",
                  "description": "http(s), mailto or relative."
                }
              },
              "required": [
                "href"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
