{
  // The website, checked against the packages' sources like the Vite config resolves them.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@yonailab/levit": ["../packages/levit/src/index.ts"],
      "@yonailab/levit/ai": ["../packages/levit/src/ai/index.ts"],
      "@yonailab/levit-yjs": ["../packages/yjs/src/index.ts"]
    }
  },
  "include": ["lib", "src", "vite.config.ts"]
}
