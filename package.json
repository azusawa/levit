{
  "name": "levit-monorepo",
  "private": true,
  "description": "Levit editor and its React and Vue wrappers",
  "type": "module",
  "workspaces": [
    "packages/levit"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build --workspaces",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "npm run typecheck --workspaces",
    "check:package": "npm run check:package --workspaces --if-present"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@playwright/test": "^1.65.0",
    "happy-dom": "^17.1.0",
    "publint": "^0.3.25",
    "typescript": "^5.8.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.0"
  },
  "license": "MIT"
}
