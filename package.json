{
  "name": "levit-monorepo",
  "private": true,
  "description": "Levit editor and its React and Vue wrappers",
  "type": "module",
  "workspaces": [
    "packages/levit",
    "packages/react",
    "packages/vue"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build --workspaces",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "npm run typecheck --workspaces",
    "check:package": "npm run check:package --workspaces --if-present"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@playwright/test": "^1.65.0",
    "ajv": "^8.20.0",
    "happy-dom": "^21.0.4",
    "publint": "^0.3.25",
    "typescript": "^5.8.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}
